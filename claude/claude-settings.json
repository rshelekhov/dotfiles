{
  "permissions": {
    "allow": [
      "mcp__plugin_playwright_playwright",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(tree *)",
      "Bash(which *)",
      "Bash(file *)",
      "Bash(wc *)",
      "Bash(stat *)",
      "Bash(realpath *)",
      "Bash(* --version)",
      "Bash(* --help)",
      "Bash(bun *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(go *)",
      "Bash(jq *)",
      "Bash(open *)",
      "WebFetch",
      "mcp__pencil"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git checkout .)",
      "Bash(git restore .)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: use bun, not npm. Always run bun test before committing.'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code needs your attention\" with title \"Claude Code\"'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '[.tool_input.file_path, .cwd] | @tsv' | while IFS=$'\\t' read -r file cwd; do if [[ \"$file\" == *.ts ]] || [[ \"$file\" == *.tsx ]]; then if [ -f \"$cwd/biome.json\" ] || [ -f \"$cwd/biome.jsonc\" ]; then bunx --bun biome check --write \"$file\" 2>&1; fi; fi; done"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"[\" + (now | todate) + \"] \" + .tool_input.command' >> ~/.claude/command-log.txt",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "frontend@magus": true,
    "bun@magus": true,
    "orchestration@magus": true,
    "claude-code-setup@claude-plugins-official": true,
    "codex@openai-codex": true,
    "beads@beads-marketplace": true,
    "swift-lsp@claude-plugins-official": true,
    "prisma-zod-consistency@prisma-zod-consistency": true,
    "frontend-design@claude-plugins-official": true,
    "mnemex@magus": true,
    "claudish@magus": true,
    "multimodel@magus": true,
    "dev@magus": true,
    "orchestrator@magus": true,
    "terminal@magus": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "beads-marketplace": {
      "source": {
        "source": "github",
        "repo": "steveyegge/beads"
      }
    },
    "prisma-zod-consistency": {
      "source": {
        "source": "github",
        "repo": "rshelekhov/prisma-zod-consistency"
      }
    },
    "magus": {
      "source": {
        "source": "github",
        "repo": "MadAppGang/magus"
      }
    }
  },
  "outputStyle": "explanatory",
  "language": "Russian",
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "voiceEnabled": true
}
